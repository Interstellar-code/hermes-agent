# Standalone workflow daemon unit. Do not also run a gateway-embedded scheduler.
#
#
# This unit is the Option 2 standalone daemon; keep it for environments where
# running a long-lived gateway process is not possible.
# Running this unit AND a future gateway-embedded scheduler simultaneously
# is NOT supported — they would race against the same switchui-workflows.db
# (the cross-process file lock in engine/db/migrate.py serialises schema
# migrations only; double-dispatch is a logic error, not a crash).

[Unit]
Description=Hermes Workflow Engine daemon (cron poller + scheduled-run tick)
Documentation=https://hermes-agent.nousresearch.com/docs/user-guide/features/workflow-engine
After=network.target

[Service]
Type=simple
ExecStart=/usr/bin/env hermes workflow daemon --interval 60
Restart=on-failure
RestartSec=5
# Profile-scoped home; edit for non-default profiles. Logs live under $HERMES_HOME/logs.
Environment=HERMES_HOME=%h/.hermes
StandardOutput=append:%h/.hermes/logs/workflow-daemon.log
StandardError=append:%h/.hermes/logs/workflow-daemon-error.log

[Install]
WantedBy=default.target
