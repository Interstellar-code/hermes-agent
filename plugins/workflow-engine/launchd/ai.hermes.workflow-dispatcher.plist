<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN"
  "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  macOS LaunchAgent for the Hermes Workflow Engine dispatcher.

  Install (per-user):
    cp launchd/ai.hermes.workflow-dispatcher.plist ~/Library/LaunchAgents/
    launchctl load -w ~/Library/LaunchAgents/ai.hermes.workflow-dispatcher.plist

  Uninstall:
    launchctl unload -w ~/Library/LaunchAgents/ai.hermes.workflow-dispatcher.plist
    rm ~/Library/LaunchAgents/ai.hermes.workflow-dispatcher.plist

  NOTE: A future upstream PR will add workflow.dispatch_in_gateway support so
  the scheduler runs inside the gateway process. When that ships, unload this
  plist and rely on the gateway instead. Running both simultaneously is NOT
  supported.

  IMPORTANT: The daemon is restarted only after a crash (KeepAlive SuccessfulExit=false). On a dev laptop you may prefer KeepAlive false and run
  `hermes workflow daemon` in the foreground instead.
-->
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>ai.hermes.workflow-dispatcher</string>

  <key>ProgramArguments</key>
  <array>
    <string>/usr/bin/env</string>
    <string>hermes</string>
    <string>workflow</string>
    <string>daemon</string>
    <string>--interval</string>
    <string>60</string>
  </array>

  <key>RunAtLoad</key>
  <true/>

  <!-- Restart on crash only; a clean exit (status 0, e.g. another instance holds the lock) stays down. -->
  <key>KeepAlive</key>
  <dict>
    <key>SuccessfulExit</key>
    <false/>
  </dict>

  <!-- launchd does not expand ~ or env vars: replace /Users/YOU/.hermes below
       with your real HERMES_HOME (profile-scoped home for non-default profiles).
       The daemon lock/pidfile defaults to $HERMES_HOME/workflow-daemon.pid. -->
  <key>StandardOutPath</key>
  <string>/Users/YOU/.hermes/logs/workflow-daemon.log</string>

  <key>StandardErrorPath</key>
  <string>/Users/YOU/.hermes/logs/workflow-daemon-error.log</string>

  <key>EnvironmentVariables</key>
  <dict>
    <key>HERMES_HOME</key>
    <string>/Users/YOU/.hermes</string>
    <key>PATH</key>
    <string>/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin:/opt/homebrew/bin</string>
  </dict>
</dict>
</plist>
